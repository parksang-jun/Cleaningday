# 광고 공급자: 비우면 네이티브는 AdMob, 웹은 noop. 포털 빌드는 poki | crazygames
VITE_AD_PROVIDER=
VITE_ADMOB_TESTING=true
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=
VITE_ADMOB_ANDROID_BANNER=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_IOS_REWARDED=
VITE_ADMOB_IOS_BANNER=
VITE_PRIVACY_URL=

# 스폰서 아이템·실제 제품 판매몰 (기본: 포털 빌드에서만 꺼짐)
VITE_SPONSORS_ENABLED=
VITE_MALL_ENABLED=

# 제휴 추적 코드 — 쿠팡 파트너스(lptag=AF로 시작하는 파트너스 ID), Amazon Associates(US/JP) 태그
VITE_COUPANG_LPTAG=
VITE_COUPANG_SUBID=
VITE_AMAZON_TAG_US=
VITE_AMAZON_TAG_JP=
# 베타 표시·피드백 폼 (홈 화면)
VITE_BETA=true
VITE_FEEDBACK_URL=
# 운영자 모드: 웹 기본 켬, 앱 빌드 기본 숨김. on|off 로 강제
VITE_ADMIN=

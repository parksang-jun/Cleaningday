# 프로덕션/앱 빌드 기본값 (비밀값은 .env.production.local 에 — 커밋 금지)
# 스토어 출시 빌드 — 홈 화면 BETA 배지 없음 (베타 배포 때만 true)
VITE_BETA=false
# 광고: 실제 단위 ID 가 등록된 플랫폼(iOS)은 실제 광고, 아직 없는 쪽(Android)은 테스트 광고로 돈다.
#   실기기에서 테스트 광고를 보려면 .env.production.local 에 VITE_ADMOB_TESTING=true 를 넣는다.
#   (본인 기기는 AdMob 콘솔 > 설정 > 테스트 기기 에 등록해 두는 쪽이 안전하다)
VITE_PRIVACY_URL=https://parksang-jun.github.io/Cleaningday/privacy.html
# VITE_FEEDBACK_URL=https://forms.gle/...   ← 베타 피드백 구글 폼 만든 뒤 입력
# 결과 화면의 실제 제품(쿠팡) 추천 카드 — 1.0 출시에서는 끈다 (앱과 무관한 쇼핑 링크로 심사 지적 소지)
VITE_MALL_ENABLED=false
